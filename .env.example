# Base de Datos PostgreSQL en la nube (Neon, Supabase, Vercel Postgres, Railway)
DATABASE_URL="postgresql://usuario:contraseña@host:5432/nombre_bd?sslmode=require"

# Supabase Auth & Storage (@supabase/ssr)
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-de-supabase"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-de-supabase"

# Teléfono oficial del lavadero para WhatsApp (atención manual y reservas directas)
NEXT_PUBLIC_LAVADERO_WHATSAPP="+54 9 260 465-4255"

# URL base de la aplicación (en Vercel se autogenera o se asigna tu dominio)
NEXT_PUBLIC_APP_URL="https://lavadero-san-rafael.vercel.app"

# Integración con Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN="PROD-ACCESS-TOKEN-O-TEST"

# Token de protección para tareas programadas (Vercel Cron)
CRON_SECRET="tu-cron-secret-seguro-aqui"

# ==============================================================
# RECORDATORIOS DE 24HS POR WHATSAPP AUTOMATIZADO
# ==============================================================
# Proveedor seleccionado: 'meta' | 'ultramsg' | 'twilio' | 'custom'
# Si se deja vacío, la app detecta automáticamente según las claves presentes,
# o ejecuta en modo Simulación seguro (Dry-Run) sin arrojar errores.
WHATSAPP_PROVIDER="meta"

# OPCIÓN 1: Meta WhatsApp Cloud API (Oficial y Gratuito hasta 1.000 conversaciones/mes)
# Obtén estas credenciales en https://developers.facebook.com
WHATSAPP_API_KEY="EAA..."
WHATSAPP_PHONE_ID="123456789012345"

# OPCIÓN 2: UltraMsg (Conexión rápida escaneando código QR de WhatsApp)
# Obtén estas credenciales en https://ultramsg.com
# WHATSAPP_INSTANCE_ID="instance12345"
# WHATSAPP_API_KEY="token12345"

# OPCIÓN 3: Twilio WhatsApp
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_WHATSAPP_FROM="+14155238886"

# OPCIÓN 4: Gateway Personalizado / Evolution API / Z-API / Webhook
# WHATSAPP_API_URL="https://tu-servidor-whatsapp.com/api/send"
